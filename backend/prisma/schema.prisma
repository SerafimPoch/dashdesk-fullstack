enum AccountProvider {
  GOOGLE
  APPLE
  MICROSOFT
}

enum ScheduleAccent {
  GREEN
  PURPLE
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  firstName             String?
  lastName              String?
  email                 String                 @unique
  passwordHash          String?
  dateOfBirth           DateTime?              @db.Date
  phoneNumber           String?
  address               String?
  twoFactorEnabled      Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  avatar                UserAvatar?
  sessions              Session[]
  accounts              Account[]
  schedules             Schedule[]
  transactions          Transaction[]
  transactionDateRanges TransactionDateRange[]
}

model UserAvatar {
  userId    String   @id
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String          @id @default(uuid())
  userId            String
  provider          AccountProvider
  providerAccountId String
  email             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Schedule {
  id        String         @id @default(uuid())
  userId    String
  title     String
  startsAt  DateTime
  endsAt    DateTime
  location  String
  accent    ScheduleAccent @default(GREEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
}

model Transaction {
  id         String   @id @default(uuid())
  userId     String
  name       String
  email      String
  product    String
  quantity   Int
  totalCents Int
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, date])
}

model TransactionDateRange {
  id        String   @id @default(uuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, startsAt, endsAt])
  @@index([userId, startsAt])
}
